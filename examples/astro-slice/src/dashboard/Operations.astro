---
import fixture from '../../../page-archetypes/content/dashboards.json';
import {operationsDataIssue,operationsSnapshotLabel,operationsView} from '../../../page-archetypes/jekyll/assets/js/dashboard-model.mjs';
import {dashboardPayload,serializeForScript} from './fixture.mjs';
import DashboardNav from './DashboardNav.astro';
import {peerDashboardURL} from './peer.mjs';
import MartletButton from '@martlet/astro/Button.astro';
import KrigsvoldButton from '@krigsvold/astro/Button.astro';
import '../../../page-archetypes/jekyll/assets/css/dashboard.css';
import './operations.css';
import './dashboard-integration.css';
import martletCSS from './operations-martlet.css?raw';
import krigsvoldCSS from './operations-krigsvold.css?raw';
const family=process.env.NIGHTJAR_FAMILY;
const Button=family==='martlet'?MartletButton:KrigsvoldButton;
const {href,page}=Astro.props;
const peer=peerDashboardURL(process.env.NIGHTJAR_PEER_URL,'operations');
const peerFamily=family==='martlet'?'Krigsvold':'Martlet';
const values={'ex-text':'text','ex-muted':'muted','ex-bg':'bg','ex-panel':'panel','ex-line':'line','ex-link':'link','dash-ui-font':'font-sans','dash-number-font':family==='krigsvold'?'font-mono':'font-sans','dash-chart-primary':'chart-1','dash-chart-secondary':'chart-2','dash-warning':'warning','dash-danger':'danger','dash-success':'green','dash-overlay':'overlay-scrim'};
const variables=Object.entries(values).map(([name,token])=>`--${name}:var(--${family}-${token})`).join(';');
const metrics=[['warnings','Services under warning'],['latency','Latest mean latency'],['open_alerts','Unacknowledged alerts'],['queue','Queued observations']];
const dataIssue=operationsDataIssue(fixture);
const snapshotLabel=operationsSnapshotLabel(fixture.as_of);
const initialView=dataIssue ? null : operationsView(fixture,{});
const json=serializeForScript(dashboardPayload('operations',fixture));
---
<style is:inline set:html={family==='martlet'?martletCSS:krigsvoldCSS}></style>
<div class="dash-app" data-dashboard="operations" data-family={family} style={variables}>
  <div class="dash-layout">
    <DashboardNav href={href} current="operations" />
    <div class="dash-main">
      <header class="dash-heading"><p class="eyebrow">{page.category}</p><h1>{page.title}</h1><p>{page.summary}</p></header>
      <p>Snapshot: {snapshotLabel ? <time datetime={fixture.as_of}>{snapshotLabel}</time> : <span>Invalid snapshot timestamp</span>} <a data-compare href={peer || href('/examples/dashboard-operations/')} hidden={!peer}>Compare in {peerFamily}</a></p>
      <p class="ops-notice">Synthetic demonstration data. Changes remain in this page’s memory and reset on reload. No live people, systems, or services are connected.</p>
      {dataIssue ? <p role="alert">{dataIssue}</p> : <>
      <form class="dash-toolbar" id="operations-filters" novalidate><fieldset disabled data-dashboard-controls><legend>Operational scope and thresholds</legend><div class="dash-controls">
        <div><label for="operations-hours">Monitoring window</label><select name="hours" id="operations-hours"><option value="6">Last 6 hours</option><option value="12">Last 12 hours</option><option value="24">Last 24 hours</option></select></div>
        <div><label for="operations-service">Service</label><select name="service" id="operations-service"><option value="">All services</option>{fixture.services.map(service=><option value={service.id}>{service.name}</option>)}</select></div>
        <div><label for="operations-threshold">Warning threshold (ms)</label><input type="number" id="operations-threshold" name="threshold" min="50" max="1000" step="1" value="250" required aria-describedby="threshold-help" /><p id="threshold-help">Applied to each service’s latest latency.</p></div>
        <div><label for="operations-severity">Alert severity</label><select name="severity" id="operations-severity"><option>All</option><option>Critical</option><option>Warning</option><option>Info</option></select></div>
      </div><label><input type="checkbox" name="hideAcknowledged" /> Hide acknowledged alerts</label><Button type="submit">Apply monitoring controls</Button><Button type="button" data-reset-operations>Reset operations preview</Button></fieldset><p id="operations-error" class="dash-error" role="alert" hidden></p></form>
<p data-dashboard-fallback>Interactive dashboard controls are unavailable. Reload to try again.</p>
      <p class="dash-status" role="status" data-dashboard-status>Published synthetic monitoring snapshot.</p>
      <p data-sample-coverage></p><dl class="dash-metrics" aria-label="Operations summary">{metrics.map(([id,label])=><div class="dash-metric"><dt>{label}</dt><dd><output data-metric={id}>—</output><p data-comparison={id}>Calculated from the table below.</p></dd></div>)}</dl>
      <div class="dash-grid"><figure class="dash-panel dash-chart" aria-labelledby="latency-title"><header><h2 id="latency-title">Latency trend</h2><p>Mean latency across selected services. The threshold applies separately to each service.</p></header><div class="dash-chart__plot" data-chart="latency"></div><figcaption data-chart-summary="latency">The data table provides an alternative to the chart.</figcaption><details><summary>View latency trend data</summary><div class="example-table-scroll" role="region" aria-label="Latency trend data" tabindex="0"><table data-chart-table="latency"><caption>Latency trend — synthetic data</caption><thead><tr><th scope="col">Label</th><th scope="col">Mean latency (ms)</th></tr></thead><tbody>{initialView?.points.length ? initialView.points.map(point=><tr><th scope="row">{point.time.slice(11,16)} UTC</th><td>{point.latency_ms}</td></tr>) : <tr><td colspan="2">No common observations are available for this chart.</td></tr>}</tbody></table></div></details></figure>
      <section class="dash-panel" aria-labelledby="activity-title"><h2 id="activity-title">Activity timeline</h2><p>Selected service scope. Local acknowledgements are clearly labelled.</p><ol class="dash-timeline" data-activity>{fixture.activity.map(event=><li><time datetime={event.time}>{event.time}</time>{event.title}</li>)}</ol></section></div>
      <section class="dash-panel" aria-labelledby="services-title"><h2 id="services-title">Service status</h2><p data-availability>Latest service readings may have different times. Availability is a sampled demonstration value, not a live SLA measurement.</p><div class="example-table-scroll" role="region" aria-label="Service status table" tabindex="0"><table id="service-table"><caption>Latest synthetic service measurements</caption><thead><tr><th scope="col">Service</th><th scope="col">Latest sample (UTC)</th><th scope="col">Status</th><th scope="col">Latency (ms)</th><th scope="col">Queue</th><th scope="col">Sample availability (%)</th></tr></thead><tbody>{fixture.services.map(service=>{const latest=[...service.samples].sort((a,b)=>a.time.localeCompare(b.time)).at(-1);return <tr><th scope="row">{service.name}</th><td>{latest.time}</td><td>See latency threshold</td><td>{latest.latency_ms}</td><td>{latest.queue}</td><td>{latest.availability}</td></tr>})}</tbody></table></div></section>
      <section class="dash-panel" aria-labelledby="alerts-title"><h2 id="alerts-title">Alerts</h2><p>Severity and acknowledgement are separate states. Acknowledgements change only this local preview.</p><p data-alert-count></p><div class="example-table-scroll" role="region" aria-label="Operational alerts table" tabindex="0"><table id="alert-table"><caption>Synthetic alert register</caption><thead><tr><th scope="col">Alert</th><th scope="col">Service</th><th scope="col">Severity</th><th scope="col">Opened (UTC)</th><th scope="col">Acknowledgement</th><th scope="col">Action</th></tr></thead><tbody>{fixture.alerts.map(alert=><tr><th scope="row">{alert.id} · {alert.title}</th><td>{alert.service_id}</td><td>{alert.severity}</td><td>{alert.time}</td><td>{alert.acknowledged?'Acknowledged':'Unacknowledged'}</td><td>JavaScript required</td></tr>)}</tbody></table></div></section>
      <noscript><p>Interactive filtering and charts require JavaScript. The published data tables remain available; controls are disabled.</p></noscript>
      </>}
    </div>
  </div>
</div>
<script type="application/json" id="dashboard-data" is:inline set:html={json}></script>
<script>import '../../../page-archetypes/jekyll/assets/js/dashboards.mjs';</script>
