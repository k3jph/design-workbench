---
import fixture from '../../../page-archetypes/content/dashboards.json';
import {dashboardSnapshotLabel} from '../../../page-archetypes/jekyll/assets/js/dashboard-model.mjs';
import {dashboardPayload,serializeForScript} from './fixture.mjs';
import DashboardNav from './DashboardNav.astro';
import {peerDashboardURL} from './peer.mjs';
import MartletButton from '@martlet/astro/Button.astro';
import KrigsvoldButton from '@krigsvold/astro/Button.astro';
import '../../../page-archetypes/jekyll/assets/css/dashboard.css';
import './administration.css';
import './dashboard-integration.css';
import martletCSS from './administration-martlet.css?raw';
import krigsvoldCSS from './administration-krigsvold.css?raw';
const snapshotLabel=dashboardSnapshotLabel(fixture.as_of);
const family=process.env.NIGHTJAR_FAMILY;
const Button=family==='martlet'?MartletButton:KrigsvoldButton;
const {href,page}=Astro.props;
const peer=peerDashboardURL(process.env.NIGHTJAR_PEER_URL,'administration');
const peerFamily=family==='martlet'?'Krigsvold':'Martlet';
const tokens={'ex-text':'text','ex-strong':'text','ex-muted':'muted','ex-bg':'bg','ex-panel':'panel','ex-line':'line','ex-link':'link','ex-focus':'link','dash-ui-font':'font-sans','dash-number-font':family==='krigsvold'?'font-mono':'font-sans','dash-chart-primary':'chart-1','dash-chart-secondary':'chart-2','dash-warning':'warning','dash-danger':'danger','dash-success':'green','dash-overlay':'overlay-scrim'};
const variables=Object.entries(tokens).map(([name,token])=>`--${name}:var(--${family}-${token})`).join(';');
const json=serializeForScript(dashboardPayload('administration',fixture));
const people=[...fixture.people].sort((a,b)=>a.name.localeCompare(b.name,'en'));
---
<style is:inline set:html={family==='martlet'?martletCSS:krigsvoldCSS}></style>
<div class="dash-app" data-dashboard="administration" data-family={family} style={variables}>
  <div class="dash-layout">
    <DashboardNav href={href} current="administration" />
    <div class="dash-main">
      <header class="dash-heading"><p class="eyebrow">{page.category}</p><h1>{page.title}</h1><p>{page.summary}</p></header>
      <p>Snapshot: {snapshotLabel ? <time datetime={fixture.as_of}>{snapshotLabel}</time> : <span>Invalid snapshot timestamp</span>} <a data-compare href={peer || href('/examples/dashboard-administration/')} hidden={!peer}>Compare in {peerFamily}</a></p>
      <p class="admin-notice">Synthetic demonstration data. Changes remain in this page’s memory and reset on reload. No live people, systems, or services are connected.</p>
      <form class="example-form dash-toolbar" id="people-filters"><fieldset disabled data-dashboard-controls><legend>Directory filters and state preview</legend><div class="dash-controls">
        <div><label for="people-query">Search people</label><input type="search" name="query" id="people-query" placeholder="Name, email, role, or ID" maxlength="120" /></div>
        <div><label for="people-status">Status</label><select name="status" id="people-status"><option>All</option><option>Active</option><option>Invited</option><option>Suspended</option></select></div>
        <div><label for="people-size">Rows per page</label><select name="size" id="people-size"><option>5</option><option>10</option><option>20</option></select></div>
        <div><label for="people-density">Table density</label><select name="density" id="people-density"><option value="comfortable">Comfortable</option><option value="compact">Compact</option></select></div>
        <div><label for="people-state">State preview</label><select name="state" id="people-state"><option value="ready">Ready</option><option value="loading">Loading</option><option value="error">Error</option><option value="empty">Empty</option></select></div>
      </div><Button type="submit">Apply directory filters</Button><Button type="button" data-clear-people>Clear filters</Button></fieldset></form>
<p data-dashboard-fallback>Interactive dashboard controls are unavailable. Reload to try again.</p>
      <p class="dash-status" role="status" data-dashboard-status>Published synthetic directory.</p>
      <section class="dash-panel" aria-labelledby="directory-title"><h2 id="directory-title">People directory</h2>
        <div class="dash-actions"><span data-selection-count>0 people selected.</span><Button type="button" data-bulk="Active" disabled>Activate selected</Button><Button type="button" data-bulk="Suspended" disabled>Suspend selected</Button><Button type="button" data-new-person disabled>Add person</Button></div>
        <div class="dash-state" data-directory-state hidden></div><div class="example-table-scroll" role="region" aria-label="People directory table" tabindex="0" data-directory-region>
          <table id="people-table"><caption>Synthetic people — select visible records or edit an individual</caption><thead><tr><th scope="col"><input class="dash-row-check" type="checkbox" data-select-page aria-label="Select visible people" disabled /></th>{['name','email','role','status'].map((field,i)=><th scope="col" aria-sort={i===0?'ascending':'none'}><button class="dash-sort" type="button" data-sort={field} disabled>{field[0].toUpperCase()+field.slice(1)}</button></th>)}<th scope="col">Action</th></tr></thead><tbody>{people.map(person=><tr><td>—</td><th scope="row">{person.name}</th><td>{person.email}</td><td>{person.role}</td><td>{person.status}</td><td>{person.id}</td></tr>)}</tbody></table>
        </div><nav class="example-pagination" aria-label="People pages"><Button type="button" data-people-previous disabled>Previous page</Button><span data-people-page>All published records</span><Button type="button" data-people-next disabled>Next page</Button></nav>
      </section>
      <section class="dash-panel dash-editor" aria-labelledby="editor-title"><h2 id="editor-title" tabindex="-1">Person editor</h2><p>Use invented information only. Save updates the local directory; reload restores the fixture.</p>
        <form class="example-form" id="person-editor" novalidate><div class="dash-error" role="alert" id="person-errors" hidden></div><fieldset disabled data-dashboard-controls><legend data-editor-legend>Add a person</legend><div class="dash-editor-grid">
          <div><label for="person-name">Full name</label><input id="person-name" name="name" required minlength="2" maxlength="120" /><p class="dash-error" id="person-name-error" hidden></p></div>
          <div><label for="person-email">Email address</label><input id="person-email" name="email" type="email" required maxlength="254" /><p class="dash-error" id="person-email-error" hidden></p></div>
          <div><label for="person-role">Role</label><select id="person-role" name="role"><option>Researcher</option><option>Editor</option><option>Coordinator</option></select><p class="dash-error" id="person-role-error" hidden></p></div>
          <div><label for="person-status">Person status</label><select id="person-status" name="status"><option>Invited</option><option>Active</option><option>Suspended</option></select><p class="dash-error" id="person-status-error" hidden></p></div>
        </div><Button type="submit">Save person locally</Button><Button type="button" data-discard-person>Discard draft</Button></fieldset></form>
      </section>
      <dialog class="dash-dialog" aria-labelledby="bulk-title" data-bulk-dialog><h2 id="bulk-title">Confirm directory change</h2><p data-bulk-description></p><p>This changes only the selected synthetic records in this page’s memory.</p><div class="dash-actions"><Button type="button" data-bulk-cancel>Cancel</Button><Button type="button" data-bulk-confirm>Confirm change</Button></div></dialog>
      <noscript><p>Interactive filtering and editing require JavaScript. The published synthetic directory remains available; controls are disabled.</p></noscript>
    </div>
  </div>
</div>
<script type="application/json" id="dashboard-data" is:inline set:html={json}></script>
<script>import '../../../page-archetypes/jekyll/assets/js/dashboards.mjs';</script>
