---
const {name, groups} = Astro.props;
---
<footer class="nightjar-footer"><div class="nightjar-footer__inner">
  <div class="nightjar-footer__identity"><strong>{name}</strong><p>Fictional example using synthetic content.</p></div>
  {groups.map(group => <nav aria-label={group.label}><h2>{group.label}</h2><ul>{group.links.map(link => <li><a href={link.href}>{link.label}</a></li>)}</ul></nav>)}
</div></footer>
