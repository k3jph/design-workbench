---
import { renderMarkdown } from '../markdown.mjs';
import Search from './Search.astro';
import DemoForm from './DemoForm.astro';
import Catalog from './Catalog.astro';
import Gallery from './Gallery.astro';
import Workspace from './Workspace.astro';
import Chat from './Chat.astro';
import Simulations from './Simulations.astro';
import ListingEnhancement from './ListingEnhancement.astro';
import { exampleImage } from '../assets.mjs';
import { formatCatalogDate } from '../../../page-archetypes/lib/catalog-date.mjs';
import { isValidEventDateTime, isEventEndBeforeStart } from '../../../page-archetypes/lib/event-time.mjs';
const {page, href, base, Button} = Astro.props;

---
<div class="recipe" data-example={page.id} data-semantic-class={page.semantic_class}>
  {page.semantic_class === 'article' && <>
    <nav aria-label="Article context"><a href={href('/examples/person/')}>About {page.author}</a> · <a href={href('/examples/archive/')}>All writing</a></nav>
    <ul class="recipe-tags" aria-label="Article subjects">{page.tags.map(tag => <li><a href={href('/examples/categories/')}>{tag}</a></li>)}</ul>
  </>}
  {page.semantic_class === 'event' && <aside aria-label="Event details"><p><strong>Event details</strong></p><p>{isValidEventDateTime(page.event.start)?<time datetime={page.event.start}>{page.event.display_start}</time>:<span>{page.event.display_start} (invalid start time)</span>} to {isValidEventDateTime(page.event.end)?<time datetime={page.event.end}>{page.event.display_end}</time>:<span>{page.event.display_end} (invalid end time)</span>} · {page.event.timezone}</p>{isEventEndBeforeStart(page.event.start,page.event.end) && <p>Event end is earlier than its start. Check the event times.</p>}<p>{page.event.location} · {page.event.registration}</p></aside>}
  {page.semantic_class === 'catalog-index' && <Catalog href={href} />}
  {['reading','document'].includes(page.composition) && <nav class="recipe-local-index" aria-label="On this page"><p>On this page</p><ol>{page.sections.map(section => <li><a href={`#${section.id}`}>{section.title}</a></li>)}</ol></nav>}
  {page.sections.map(section => <section aria-labelledby={section.id}>
    <h2 id={section.id}>{section.title}</h2>
    {section.body && <div class="recipe-prose" set:html={renderMarkdown(section.body, base, {fixtureMarkup: page.id === 'stress-test', docId:`${page.id}-${section.id}`})} />}
    {section.kind === 'cards' && <ul class="recipe-list">{section.items.map(item => <li><h3><a href={href(item.url)}>{item.title}</a></h3><p>{item.summary}</p></li>)}</ul>}
    {section.kind === 'listing' && <div data-listing>
      <ul class="recipe-entries">{section.items.map(item => <li data-list-item>
      {(item.date || item.tag) && <p class="recipe-meta">{item.date && (formatCatalogDate(item.date) ? <time datetime={item.date}>{formatCatalogDate(item.date)}</time> : <span>Invalid date: {item.date}</span>)}{item.date && item.tag && ' · '}{item.tag}</p>}
      <h3><a href={href(item.url)}>{item.title}</a></h3><p>{item.summary}</p>
      </li>)}</ul>
      {section.items.length > 3 && <><nav data-pagination aria-label={`${section.title} pages`} hidden>
        <Button data-previous>Previous</Button> <span data-page-status role="status"></span> <Button data-next>Next</Button>
      </nav><ListingEnhancement /></>}
    </div>}
    {section.kind === 'table' && <div class="recipe-table" role="region" aria-label={`${section.title} table`} tabindex="0"><table><caption>{section.title}</caption><thead><tr>{section.headers.map(header => <th scope="col">{header}</th>)}</tr></thead><tbody>{section.rows.map(row => <tr>{row.map((cell,index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table></div>}
    {section.kind === 'figure' && <figure><img src={exampleImage(section.image)} alt={section.alt} width="960" height="640" loading="lazy" /><figcaption>{section.caption}</figcaption></figure>}
    {section.kind === 'gallery' && <Gallery section={section} Button={Button} />}
    {['sensors','scene'].includes(section.kind) && <Simulations kind={section.kind} id={section.id} />}
    {section.kind === 'faq' && <div>{section.items.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>}
    {section.kind === 'stats' && <dl>{section.items.map(item => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}</dl>}
    {section.kind === 'plans' && <div class="recipe-list">{section.items.map(item => <article><h3>{item.title}</h3><p>{item.price}</p><p>{item.summary}</p><ul>{item.features.map(feature=><li>{feature}</li>)}</ul><Button href={href(item.action.url)} download={item.action.download}>{item.action.label}</Button></article>)}</div>}
    {section.kind === 'workspace' && <Workspace section={section} Button={Button} />}
    {section.kind === 'chat' && <Chat Button={Button} />}
    {section.kind === 'form' && <DemoForm kind={section.form} id={section.id} Button={Button} />}
    {section.kind === 'search' && <Search base={base} id={section.id} title={section.title} Button={Button} />}
    {section.kind === 'facts' && <dl>{section.facts.map(fact => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl>}
    {section.actions && <ul class="recipe-actions">{section.actions.map(action => <li><Button href={href(action.url)} download={action.download}>{action.label}</Button></li>)}</ul>}
  </section>)}
</div>
<style>
.recipe { max-width: 72rem; margin-inline: auto; padding: 0 1.5rem 3rem; overflow-wrap:anywhere; }
.recipe-local-index { margin-block: 2rem; }
.recipe-local-index p { font-weight: 700; }
.recipe-local-index ol { list-style: none; padding: 0; }
.recipe-local-index li { margin-block: .6rem; }
.recipe-prose { overflow-wrap:anywhere; }
.recipe section { margin-block: 2.5rem; }
.recipe :is(h2,h3) { line-height:1.25; }
.recipe h2 { font-size:clamp(1.5rem,2.4vw,2rem); margin:0 0 1.25rem; }
.recipe h3 { font-size:1.2rem; }
.recipe-list { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: 1.5rem; }
.recipe-entries { list-style: none; padding: 0; }
.recipe-entries li { margin-block: 1.5rem; }
.recipe-list h3, .recipe-entries h3 { margin:0 0 .7rem; }
.recipe-meta { font-size: .875rem; }
.recipe dl > div { margin-block: 1rem; }
.recipe dt { font-weight: 700; }
.recipe dd { margin-inline-start: 0; }
.recipe figure { margin-inline: 0; }
.recipe figure img { max-width: 100%; height: auto; }
.recipe-table { max-width: 100%; overflow-x: auto; }
.recipe-table :is(th,td) { min-inline-size: 8rem; }
.recipe-tags { display: flex; gap: 1rem; padding: 0; list-style: none; }
@media print { [data-list-item][hidden] { display: list-item !important; } [data-pagination], .recipe-local-index { display: none !important; } }
.recipe-actions { list-style: none; padding: 0; display: flex; gap: 1rem; flex-wrap: wrap; }
</style>

