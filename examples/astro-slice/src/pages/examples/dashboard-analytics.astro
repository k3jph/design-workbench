---
import catalog from '../../../../page-archetypes/content/catalog.json';
import Shell from '@nightjar/shell';
import Analytics from '../../dashboard/Analytics.astro';
import '../../dashboard/analytics.css';
import '../../dashboard/dashboard-integration.css';
const record=catalog.pages.find(page=>page.id==='dashboard-analytics');
const page={...record,sections:[]};
const base=import.meta.env.BASE_URL;
const href=url=>url.startsWith('/')&&!url.startsWith('//')?`${base.replace(/\/$/,'')}${url}`:url;
---
<Shell page={page} href={href} base={base}><Analytics base={base} page={record} /></Shell>
