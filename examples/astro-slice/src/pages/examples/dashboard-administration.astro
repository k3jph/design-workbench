---
import catalog from '../../../../page-archetypes/content/catalog.json';
import Shell from '@nightjar/shell';
import Administration from '../../dashboard/Administration.astro';
const record=catalog.pages.find(page=>page.id==='dashboard-administration');
const page={...record,sections:[]};
const base=import.meta.env.BASE_URL;
const href=url=>url.startsWith('/')&&!url.startsWith('//')?`${base.replace(/\/$/,'')}${url}`:url;
---
<Shell page={page} href={href} base={base}><Administration href={href} page={record} /></Shell>
