---
import Shell from '@nightjar/shell';
import content from '../../../../page-archetypes/jekyll/_includes/examples/scientific.html?raw';
import '../../../../page-archetypes/jekyll/assets/css/scientific.css';
const page={id:'scientific-workspace',title:'Thermal analysis',category:'Scientific workspace',summary:'An illustrative thermal response, calculated locally.',composition:'workspace',semantic_class:'scientific-workspace',sections:[]};
const base=import.meta.env.BASE_URL;
const href=url=>url.startsWith('/')&&!url.startsWith('//')?`${base.replace(/\/$/,'')}${url}`:url;
---
<Shell page={page} href={href} base={base}><div set:html={content} /></Shell>
<script>import '../../../../page-archetypes/jekyll/assets/js/scientific.mjs';</script>
