---
import Shell from '@nightjar/shell';
const base = import.meta.env.BASE_URL;
const href = url => url.startsWith('/') && !url.startsWith('//') ? `${base.replace(/\/$/, '')}${url}` : url;
const page = {id:'index', title:'A collection of possibilities.', summary:'Shared content, independent compositions, and clear boundaries between publishing and applications.', semantic_class:'catalog-index', composition:'landing', sections:[]};
---
<Shell page={page} href={href} base={base} />
