new file mode 100644
index 0000000..e2dfaee
--- /dev/null
+++ b/site/rehype-source-links.mjs
@@ -0,0 +1,19 @@
+// Adapt immutable upstream Markdown links/IDs to the assembled language page.
+// The copied source documents and their provenance remain unchanged.
+export default function sourceLinks() {
+  return (tree, file) => {
+    const isQueryResults = String(file.path ?? file.history?.[0] ?? '').includes('language-query-results.md');
+    const visit = node => {
+      if (node.type === 'element') {
+        if (isQueryResults && node.tagName === 'h3' && node.children?.some(child => child.type === 'text' && child.value === 'Purpose and composition')) {
+          node.properties.id = 'query-results-purpose-and-composition';
+        }
+        if (node.tagName === 'a' && node.properties?.href === 'form-styling.md') {
+          node.properties.href = '#form-styling';
+        }
+      }
+      for (const child of node.children ?? []) visit(child);
+    };
+    visit(tree);
+  };
+}
