diff --git a/scripts/rebase-react-reference.mjs b/scripts/rebase-react-reference.mjs
new file mode 100644
index 0000000..086d700
--- /dev/null
+++ b/scripts/rebase-react-reference.mjs
@@ -0,0 +1,20 @@
+// The checksum-verified React reference is built for its own root domain.
+// Adapt only the generated site copy; the extracted source and archive stay intact.
+import {readFile,writeFile,readdir,access} from 'node:fs/promises';
+import {join} from 'node:path';
+const base='/' + (process.env.SITE_BASE || '/').split('/').filter(Boolean).join('/');
+const prefix=base==='/' ? '/' : base+'/';
+const root='dist/react';
+const files=['index.html',...(await readdir(join(root,'assets'))).filter(name=>/\.(?:js|css)$/.test(name)).map(name=>`assets/${name}`)];
+for(const file of files){
+ const path=join(root,file);let text=await readFile(path,'utf8');
+ const assets=[...new Set(text.match(/\/assets\/[a-zA-Z0-9._/-]+/g)||[])];
+ for(const asset of assets){
+  const inReference=await access(join(root,asset.slice(1))).then(()=>true,()=>false);
+  text=text.replaceAll(asset,prefix+(inReference?'react/':'')+asset.slice(1));
+ }
+ if(file.endsWith('.js')) for(const segment of ['/agents/','/design-language/','/design-system/','/privacy-and-cookie-notice/','/martlet-mark.svg','/krigsvold-mark.svg']){
+  text=text.replaceAll(`"${segment}`,`"${prefix}${segment.slice(1)}`).replaceAll(`'${segment}`,`'${prefix}${segment.slice(1)}`).replaceAll('`'+segment,'`'+prefix+segment.slice(1));
+ }
+ await writeFile(path,text);
+}
