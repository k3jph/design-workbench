diff --git a/scripts/check-base.mjs b/scripts/check-base.mjs
new file mode 100644
index 0000000..ca436d7
--- /dev/null
+++ b/scripts/check-base.mjs
@@ -0,0 +1,32 @@
+import assert from 'node:assert/strict';
+import {createServer} from 'node:http';
+import {createHash} from 'node:crypto';
+import {readFile,stat} from 'node:fs/promises';
+import {resolve,join,extname} from 'node:path';
+import {chromium,firefox,webkit} from 'playwright';
+const base='/' + (process.env.SITE_BASE || '/').split('/').filter(Boolean).join('/');
+const prefix=base==='/' ? '/' : base+'/';
+const root=resolve('dist');
+const family=JSON.parse(await readFile('package.json','utf8')).name.split('-')[0];
+const expected={martlet:['2.2.2','82215524d7b34f020df3095f07bcec7f039b49c8776da1f65194f67d43c4a8c6'],krigsvold:['2.2.3','fb471d8c2ad3d7aafa17bbe0eddc20e37754c2e28f16504c94e84c134ce308cd']}[family];
+assert.ok(expected,'known family');
+const [version,sha]=expected;
+assert.equal(createHash('sha256').update(await readFile(join(root,'downloads',`${family}-theme-${version}.tgz`))).digest('hex'),sha,'published legacy download bytes');
+await assert.rejects(readFile(join(root,'downloads',`${family}-core-${version}.tgz`)),{code:'ENOENT'},'private core must not appear among downloads');
+const type={'.html':'text/html','.js':'text/javascript','.css':'text/css','.svg':'image/svg+xml','.json':'application/json','.woff2':'font/woff2'};
+const server=createServer(async(req,res)=>{
+ try {const url=new URL(req.url,'http://localhost');if(!url.pathname.startsWith(prefix)){res.writeHead(404).end();return;}let path=resolve(root,'.'+decodeURIComponent(url.pathname.slice(prefix.length-1)));if(path!==root&&!path.startsWith(root+'/')){res.writeHead(403).end();return;}if((await stat(path)).isDirectory())path=join(path,'index.html');const body=await readFile(path);res.writeHead(200,{'content-type':type[extname(path)]||'application/octet-stream'}).end(body);}catch{res.writeHead(404).end();}
+});
+await new Promise(ok=>server.listen(0,'127.0.0.1',ok));
+const origin=`http://127.0.0.1:${server.address().port}`;
+const engine=process.env.WORKBENCH_BROWSER||'chromium';
+const browser=await ({chromium,firefox,webkit})[engine].launch(engine==='chromium'&&process.env.PLAYWRIGHT_EXECUTABLE_PATH?{executablePath:process.env.PLAYWRIGHT_EXECUTABLE_PATH}:{});
+try {
+ for(const route of ['', 'design-language/', 'design-system/', 'agents/', 'privacy-and-cookie-notice/', 'react/']){
+  const page=await browser.newPage();const errors=[];page.on('pageerror',error=>errors.push(error.message));page.on('response',response=>{if(response.url().startsWith(origin)&&response.status()>=400)errors.push(`${response.status()} ${response.url()}`);});
+  const response=await page.goto(origin+prefix+route,{waitUntil:'networkidle'});assert.equal(response.status(),200,route);await page.locator('h1').first().waitFor({timeout:15000});
+  for(const href of await page.locator('a[href^="/"]').evaluateAll(nodes=>nodes.map(n=>n.getAttribute('href'))))assert.ok(href.startsWith(prefix),`${route}: ${href} loses ${prefix}`);
+  assert.deepEqual(errors,[],`${route}: load errors`);await page.close();
+ }
+ console.log(`${engine}: ${prefix} site and embedded React reference routes passed`);
+} finally {await browser.close();await new Promise(ok=>server.close(ok));}
